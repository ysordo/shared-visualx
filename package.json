{
    "name": "visualx",
    "version": "1.0.0",
    "description": "VisualX is a library that provides predefined, adaptable, and customizable visual components to simplify the development of modern and flexible interfaces in Node.js projects with TypeScript.",
    "author": "Junior Yohan Sordo García <juniorsordogarcia@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/ysordo/shared-visualx"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "prepublishOnly": "pnpm run build && pnpm run test",
        "build": "tsc && tsup",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "docs:generate": "typedoc"
    },
    "keywords": [
        "typescript",
        "node",
        "library",
        "components",
        "visual",
        "adaptable",
        "customizable"
    ],
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@typescript-eslint/eslint-plugin": "^8.35.1",
        "@typescript-eslint/parser": "^8.35.1",
        "eslint": "^9.30.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "tailwindcss": "^4.1.12",
        "tsup": "^8.5.0",
        "typedoc": "^0.28.7",
        "typescript": "^5.8.3"
    },
    "peerDependencies": {
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "packageManager": "pnpm@10.12.4",
    "files": [
        "dist",
        "src/styles/*.module.css",
        "src/styles/stylesMap.json"
    ]
}